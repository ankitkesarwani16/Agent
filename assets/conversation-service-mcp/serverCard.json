  "tools": [
    {
      "name": "POST_askAgent",
      "title": "POST_askAgent",
      "description": "This is the conversation endpoint for the AI agent. A session must be created before sending any messages. See createSession.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ucssa_userid",
          "ucssa_username",
          "ucssa_bps"
        ],
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "The system generates a unique ID identifying the chat session, which must be used in all subsequent requests to maintain context and track the conversation."
              },
              "input": {
                "type": "string",
                "description": "The input is the message sent by the user during the chat session, serving as the basis for the AI agentÃ¢ÂÂs reply.",
                "example": "what was my consumption in 2024"
              }
            },
            "description": "Action parameters"
          },
          "ucssa_userid": {
            "type": "string",
            "description": "The user ID of the requesting user"
          },
          "ucssa_username": {
            "type": "string",
            "description": "The username of the requesting user"
          },
          "ucssa_bps": {
            "type": "string",
            "description": "JSON array of business partner IDs, e.g. [\"1113855\"]"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "title": "Answer",
                    "properties": {
                      "sessionId": {
                        "type": "string",
                        "description": "Unique ID to identify the chat session.",
                        "example": "717cdcc4-53ec-463f-b230-08787a982b94"
                      },
                      "message": {
                        "type": "array",
                        "description": "The message field contains an array of response messages generated by the agent.",
                        "items": {
                          "type": "object",
                          "example": "{\"content\": \"Certainly, emma, I have found three premises linked to your name. Kindly choose one to proceed and view your consumption details.\",\n                  \"type\": \"text\"},\n                  {\"content\": \"[{\"standardFlag\":\"\",\"city\":\"Anytown\",\"district\":\"\",\"postalCode\":\"57201\",\"POBoxPostalCode\":\"\",\"POBox\":\"\",\"street\":\"Sunnybrook Street\",\"houseNo\":\"7245\",\"building\":\"\",\"floor\":\"\",\"roomNo\":\"\",\"countryID\":\"DE\",\"countryName\":\"\",\"region\":\"\",\"regionName\":\"\",\"timeZone\":\"CET\",\"taxJurisdictionCode\":\"\",\"languageID\":\"\",\"shortForm\":\"Sunnybrook Street 7245 / 57201 Anytown\",\"premiseTypeID\":\"0003\",\"premiseID\":\"647855\",\"premiseTypeDescription\":\"Single Family Home\"},{\"standardFlag\":\"\",\"city\":\"Anytown\",\"district\":\"\",\"postalCode\":\"57401\",\"POBoxPostalCode\":\"\",\"POBox\":\"\",\"street\":\"Main Street\",\"houseNo\":\"781\",\"building\":\"\",\"floor\":\"\",\"roomNo\":\"\",\"countryID\":\"DE\",\"countryName\":\"\",\"region\":\"\",\"regionName\":\"\",\"timeZone\":\"CET\",\"taxJurisdictionCode\":\"\",\"languageID\":\"\",\"shortForm\":\"Main Street 781 / 57401 Anytown\",\"premiseTypeID\":\"0005\",\"premiseID\":\"647856\",\"premiseTypeDescription\":\"Two-room apartment\"},{\"standardFlag\":\"\",\"city\":\"Anytown\",\"district\":\"\",\"postalCode\":\"57201\",\"POBoxPostalCode\":\"\",\"POBox\":\"\",\"street\":\"Sunnybrook Street\",\"houseNo\":\"7269\",\"building\":\"\",\"floor\":\"\",\"roomNo\":\"\",\"countryID\":\"DE\",\"countryName\":\"\",\"region\":\"11\",\"regionName\":\"\",\"timeZone\":\"CET\",\"taxJurisdictionCode\":\"\",\"languageID\":\"\",\"shortForm\":\"Sunnybrook Street 7269 / 57201 Anytown\",\"premiseTypeID\":\"0006\",\"premiseID\":\"655669\",\"premiseTypeDescription\":\"Three-room apartment\"}]\",\n      \"type\": \"premises\"\n    }",
                          "allOf": [
                            {
                              "type": "object",
                              "description": "Response message",
                              "title": "Message",
                              "properties": {
                                "type": {
                                  "type": "object",
                                  "description": "It defines the semantic category of the message, indicating the context on which the content is based.",
                                  "allOf": [
                                    {
                                      "type": "string",
                                      "description": "The message type can be one of the listed values. The message type controls which properties are available in the field content. The field content is a json string.",
                                      "enum": [
                                        "yearlyConsumption",
                                        "monthlyConsumption",
                                        "premiseSelection",
                                        "meterReading",
                                        "contractSelection",
                                        "contractDetails",
                                        "invoices",
                                        "registerInput",
                                        "userAccount",
                                        "contractAccountSelection",
                                        "text",
                                        "divisionSelection",
                                        "paymentInformation",
                                        "utilitiesProductWithPricesSelection",
                                        "deviceSelection"
                                      ],
                                      "title": "MessageType"
                                    }
                                  ]
                                },
                                "content": {
                                  "type": "string",
                                  "description": "A JSON string containing different properties, which differ depending on the message type."
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ],
                "description": "Success (HTTP 200)"
              },
              {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "target": {
                        "type": "string"
                      },
                      "details": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            },
                            "target": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "code",
                            "message"
                          ]
                        }
                      },
                      "innererror": {
                        "type": "object",
                        "description": "The structure of this object is service-specific"
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ]
                  }
                },
                "required": [
                  "error"
                ],
                "description": "Error (HTTP 4XX)"
              }
            ]
          }
        }
      }
